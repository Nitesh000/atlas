{
  "name": "@atlas/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:migrate": "dotenv -e ../../.env -- tsx src/migrate.ts",
    "db:migrate:prod": "tsx src/migrate.ts",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio"
  },
  "devDependencies": {
    "@atlas/config": "workspace:*",
    "@atlas/eslint-config": "workspace:*",
    "@atlas/typescript-config": "workspace:*",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@atlas/types": "workspace:^",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  }
}
