{
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://atlas-1azo.onrender.com/api/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}